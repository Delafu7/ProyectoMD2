[{"id_message": 86342825611, "message": "Hola disculpa que me meta pero si puedes pedirle perdon a tu mama", "date": "2020-09-27 08:02:18"}, {"id_message": 71884973492, "message": "Ella est en tu corazón y tu puedes pedirle perdon y sacar lo que te pesa por no poder haberle dicho", "date": "2020-09-27 08:03:30"}, {"id_message": 81688586766, "message": "Lo que importa es que saques todo lo que te pesa", "date": "2020-09-27 08:04:39"}, {"id_message": 34551375853, "message": "Saca eso hermano que te esta pesando mucho", "date": "2020-09-27 08:07:27"}, {"id_message": 16993291694, "message": "Tu mama donde quiera que este te escucha", "date": "2020-09-27 08:09:21"}, {"id_message": 55821504505, "message": "Hablale y dile lo que sientes", "date": "2020-09-27 08:09:33"}, {"id_message": 33039784702, "message": "Animo si ocupas con quien platicar cuenta conmigo", "date": "2020-09-27 08:16:22"}, {"id_message": 97199044030, "message": "Perdon no me presente", "date": "2020-09-27 08:18:23"}, {"id_message": 35568556237, "message": "Te mando un abraso desde mexico", "date": "2020-09-27 08:26:48"}, {"id_message": 66236127599, "message": "Eso es bueno no", "date": "2020-09-27 08:27:46"}, {"id_message": 13797396997, "message": "Te quiere en verdad", "date": "2020-09-27 08:28:20"}, {"id_message": 73292249480, "message": "Ami la mia no me valora", "date": "2020-09-27 08:29:23"}, {"id_message": 62736923533, "message": "Ya edtoy en eso pero en verdad la quiero y quiero a su niño", "date": "2020-09-27 08:30:14"}, {"id_message": 42557643576, "message": "Y siges con el", "date": "2020-09-27 08:31:02"}, {"id_message": 65912160823, "message": "Que asco de tipo", "date": "2020-09-27 08:31:39"}, {"id_message": 51954417563, "message": "Su machismo podriamos decir", "date": "2020-09-27 08:31:54"}, {"id_message": 64609388718, "message": "Si lo se influye mucho", "date": "2020-09-27 08:32:17"}]