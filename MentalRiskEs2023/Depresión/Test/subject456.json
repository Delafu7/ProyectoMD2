[{"id_message": 75906886073, "message": "Y tu familia que", "date": "2020-02-22 13:55:39"}, {"id_message": 90279696186, "message": "Pues planteate salir de casa de tus padres en vez de suicidarte hombre", "date": "2020-02-22 14:02:16"}, {"id_message": 45082368147, "message": "Yo también tengo depresión", "date": "2020-02-22 14:02:37"}, {"id_message": 64293510911, "message": "No es incompatible con currar", "date": "2020-02-22 14:02:44"}, {"id_message": 28113615784, "message": "Eso son palabras mayores", "date": "2020-02-22 14:04:11"}, {"id_message": 33121365436, "message": "Creo que sería mejor largarte de casa y no hablarles mas", "date": "2020-02-22 14:04:30"}, {"id_message": 27587388385, "message": "Nunca los he tomado así que no podría decirte nada al respecto", "date": "2020-02-22 14:05:21"}, {"id_message": 65552651326, "message": "Pues intento mirar al futuro", "date": "2020-02-22 14:06:14"}, {"id_message": 14616030382, "message": "Y pensar que todo termina", "date": "2020-02-22 14:06:25"}, {"id_message": 97115148383, "message": "Yo por ejemplo estoy en una ciudad que odio", "date": "2020-02-22 14:06:35"}, {"id_message": 77813434260, "message": "Pero en un par de años me iré", "date": "2020-02-22 14:06:46"}, {"id_message": 32924957403, "message": "Piensa a largo plazo", "date": "2020-02-22 14:06:57"}, {"id_message": 92082703861, "message": "Te joden tus padres ? Pues empieza a pensar en irte y cortar contacto", "date": "2020-02-22 14:07:13"}, {"id_message": 29292283624, "message": "Pero te lo han recetado ?", "date": "2020-02-22 14:08:45"}, {"id_message": 92371472047, "message": "A corto plazo te ayudará", "date": "2020-02-22 14:09:13"}, {"id_message": 33189805133, "message": "Y te permitirá hacer las cosas necesarias para solucionar aquello que te deprime", "date": "2020-02-22 14:09:30"}, {"id_message": 40015281632, "message": "Currar y salir de casa", "date": "2020-02-22 14:09:37"}, {"id_message": 47172760689, "message": "Te la suda todo ya", "date": "2020-02-22 14:10:11"}, {"id_message": 49816818056, "message": "Ve a por las pirulas", "date": "2020-02-22 14:10:35"}, {"id_message": 44903705767, "message": "En el tema laboral te refieres ?", "date": "2020-02-22 15:25:35"}, {"id_message": 2130501465, "message": "Solo tienes que hacerlo", "date": "2020-02-22 15:26:49"}, {"id_message": 4335925775, "message": "El gran problema de estos tiempos", "date": "2020-02-22 15:28:35"}, {"id_message": 15856003290, "message": "Tanto hablar por internet que olvidamos como relacionarnos", "date": "2020-02-22 15:29:03"}, {"id_message": 34222693864, "message": "Tienes que remontar todo lo que no hiciste en esos años de aislamiento", "date": "2020-02-22 15:30:29"}, {"id_message": 75218036570, "message": "A mi tampoco me gusta mucho salir", "date": "2020-02-22 15:31:23"}, {"id_message": 10762936816, "message": "El gimnasio me encantaba", "date": "2020-02-22 15:31:32"}, {"id_message": 82150152329, "message": "Pero me daba pereza ir", "date": "2020-02-22 15:31:39"}, {"id_message": 75136050367, "message": "Solo me gustaba cuando ya estaba allí", "date": "2020-02-22 15:31:50"}, {"id_message": 4603429144, "message": "No te creas que es tan raro", "date": "2020-02-22 15:32:23"}, {"id_message": 79317274959, "message": "A mi me gustaba ver los progresos", "date": "2020-02-22 15:32:54"}, {"id_message": 40329673114, "message": "Hace años que ya no voy", "date": "2020-02-22 15:33:03"}, {"id_message": 17966719684, "message": "Nunca entenderé que le veis al fútbol", "date": "2020-02-22 15:35:04"}, {"id_message": 11234499238, "message": "Tu eres de aquí", "date": "2020-02-22 15:56:37"}, {"id_message": 52977704047, "message": "El Madrid es mejor que el Barça", "date": "2020-02-22 18:03:56"}, {"id_message": 97207783833, "message": "Bien , más o menos", "date": "2020-03-30 16:27:35"}, {"id_message": 78170704745, "message": "Deseando salir a la calle", "date": "2020-03-30 16:27:43"}, {"id_message": 22562398567, "message": "Que dios los ayude", "date": "2020-03-30 16:29:08"}, {"id_message": 46062696504, "message": "De que parte eres ? ?", "date": "2020-03-30 16:29:34"}, {"id_message": 75376631694, "message": "Está muy jodido por allá ?", "date": "2020-03-30 16:32:10"}, {"id_message": 57910012170, "message": "Igual . Buscando trabajo como un loco", "date": "2020-05-11 22:07:11"}, {"id_message": 43764982993, "message": "Eso necesito yo . Tranquilidad", "date": "2020-05-11 22:08:01"}, {"id_message": 63495268299, "message": "De Sevilla y tu ?", "date": "2020-05-11 22:09:56"}, {"id_message": 23722383905, "message": "Como está siendo lo del coronavirus por allá ?", "date": "2020-05-11 22:16:21"}, {"id_message": 33022117469, "message": "Por que quieres bajar de peso", "date": "2020-05-12 15:51:07"}, {"id_message": 7099151718, "message": "De que parte do Brasil você é ?", "date": "2020-05-12 16:13:03"}]