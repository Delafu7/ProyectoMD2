essage": "A qui no va a pasar nada", "date": "2019-09-22 04:55:55"}, {"id_message": 14864446641, "message": "Mi papá checa mi facebook", "date": "2019-09-22 16:49:16"}, {"id_message": 83045757799, "message": "Me siento re mal", "date": "2019-10-12 00:31:05"}, {"id_message": 54520974911, "message": "Estoy enferma de bulimia y anorexia", "date": "2019-10-12 00:31:19"}, {"id_message": 6082420594, "message": "Y como se siente ?", "date": "2019-10-12 00:37:09"}, {"id_message": 51881513596, "message": "Yo solo soy gorda", "date": "2019-10-12 00:38:21"}, {"id_message": 58246201845, "message": "En mi celular si se puede", "date": "2019-10-12 20:21:25"}, {"id_message": 55602355865, "message": "De hecho sólo tengo bajones emosionales no tengo depresion", "date": "2019-10-21 21:52:41"}, {"id_message": 33463368224, "message": "Bueno si e tenido depresión", "date": "2019-10-21 21:52:47"}, {"id_message": 93064273750, "message": "Simplemente aveces no tengo con quien hablar", "date": "2019-10-21 21:53:09"}]