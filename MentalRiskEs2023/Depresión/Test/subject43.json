[{"id_message": 53418658191, "message": "Si es una manera de autoprotección", "date": "2022-05-02 01:06:44"}, {"id_message": 65615558656, "message": "Quién es de Melilla ?", "date": "2022-05-02 01:39:14"}, {"id_message": 64769632074, "message": "Ah vale . Yo estuve allí un par de veces", "date": "2022-05-02 01:46:49"}, {"id_message": 35170950883, "message": "Bueno . Tiene sus cosas malas y buenas . Como todo", "date": "2022-05-02 01:53:26"}, {"id_message": 72737486923, "message": "Melilla la vieja si", "date": "2022-05-02 01:56:00"}, {"id_message": 20502396839, "message": "A ver es muy pequeño", "date": "2022-05-02 01:56:07"}, {"id_message": 21915684215, "message": "Si entendí lo que dijiste de la gente de allí ... pues si", "date": "2022-05-02 01:57:58"}, {"id_message": 94723324484, "message": "Ah vives en londres", "date": "2022-05-02 02:37:02"}, {"id_message": 46462133622, "message": "De Melilla a Londres . Jumm", "date": "2022-05-02 02:37:11"}, {"id_message": 75151005502, "message": "No estabas en londres", "date": "2022-05-08 15:59:57"}, {"id_message": 18906334630, "message": "Ahora en casa esta mañana de paseo", "date": "2022-05-08 16:00:37"}, {"id_message": 34331123833, "message": "Bueno ... pues ahí vamos ... y tu", "date": "2022-05-08 16:01:33"}, {"id_message": 4184707711, "message": "No sé cuál es", "date": "2022-05-08 16:02:19"}, {"id_message": 99645809522, "message": "La acabo de mirar", "date": "2022-05-08 16:03:01"}, {"id_message": 99236705108, "message": "Está por ejido cerca del centro", "date": "2022-05-08 16:03:09"}, {"id_message": 83158155133, "message": "@USER que bien . Te quedas allí ?", "date": "2022-05-08 16:33:17"}, {"id_message": 18260119744, "message": "Eso iba a Nora jaja", "date": "2022-05-08 16:33:40"}]